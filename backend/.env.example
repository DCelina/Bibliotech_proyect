PORT=3000
NODE_ENV=development

# Base de datos (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=biblioteca
DB_PASS=biblioteca
DB_NAME=biblioteca

# Sesión: usar una clave larga y aleatoria (el servidor no arranca sin ella)
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# true  = el catálogo se puede consultar sin iniciar sesión (Student público)
# false = hay que iniciar sesión (cualquier rol) para consultar y descargar
PUBLIC_ACCESS=true

# Tamaño máximo por archivo subido, en MB
MAX_UPLOAD_MB=20

# Opcional: orígenes permitidos si el frontend se sirve desde otro dominio (separados por coma)
# CORS_ORIGIN=http://localhost:5500
